# i3 configuration

# Dark mode
set $gnome-schema org.gnome.desktop.interface
exec_always gsettings set $gnome-schema color-scheme 'prefer-dark'
exec_always gsettings set $gnome-schema gtk-theme 'Adwaita-dark'
exec_always --no-startup-id xdg-desktop-portal-gtk &

# Monitors (auto-detects outputs, enables any connected external display),
# then one eww bar per screen
exec_always --no-startup-id ~/.config/i3/scripts/monitors.sh; ~/.config/eww/scripts/bars.sh

# Spiral layout script (python-i3ipc package required)
set $spiralcmd python3 ~/.config/i3/scripts/spiral_layout.py

# Always run
exec_always --no-startup-id $spiralcmd
exec_always --no-startup-id dunst -conf ~/.config/dunst/dunstrc-x11

# Compositor (glx backend, no effects — fixes input lag and pixel artifacts)
exec --no-startup-id picom -b

# Pre-warm kitty server (launch on scratchpad so it's hidden)
exec --no-startup-id kitty --single-instance --class kitty-warmup
for_window [class="kitty-warmup"] move scratchpad

# Wallpaper
exec_always --no-startup-id feh --bg-scale ~/.config/wallpapers/img/pinkRose.jpg

# Disable startup notification cursor (loading spinner)
exec --no-startup-id xsetroot -cursor_name left_ptr

# Caps Lock to Escape
exec_always setxkbmap -option caps:escape

# Touchpad tap-to-click (auto-detects device name, works across laptops)
exec_always --no-startup-id ~/.config/i3/scripts/touchpad.sh

# Setting gaps
gaps inner 10

# Borders
default_border pixel 1

client.focused #FFFFFF99 #FFFFFF99 #FFFFFF99
client.unfocused #333333 #5F676A #FFFFFF #484E50 #5F676A

### Variables

# Mod1: Alt
# Mod4: Win
set $mod Mod4

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

set $term kitty --single-instance
set $menu rofi -show drun
set $browser 'zen-browser'

### Key bindings

# Basics:
    # Start a terminal
    bindsym $mod+Return exec --no-startup-id $term

    # Open your browser
    bindsym $mod+b exec --no-startup-id $browser

    # Kill focused window
    bindsym $mod+w kill

    # Start your launcher
    bindsym $mod+r exec --no-startup-id $menu

    # Lock
    bindsym $mod+Mod1+l exec --no-startup-id "i3lock -i $HOME/.config/wallpapers/img/GtfoHD-1080.png"

    # Toggle bar
    bindsym $mod+semicolon exec --no-startup-id "~/.config/eww/scripts/bars.sh toggle"

    # Increase brightness
    bindsym XF86MonBrightnessUp exec --no-startup-id "brightnessctl s +1% && eww update backlight=$(brightnessctl -m | awk -F, '{print $4}' | tr -d '%')"
    bindsym XF86MonBrightnessDown exec --no-startup-id "brightnessctl s 1%- && eww update backlight=$(brightnessctl -m | awk -F, '{print $4}' | tr -d '%')"

    # Volume control
    bindsym XF86AudioRaiseVolume exec --no-startup-id "pactl set-sink-volume 0 +5% && eww update volume=$(pactl get-sink-volume @DEFAULT_SINK@ | awk -F/ '{print $2}' | tr -dc 0-9)"
    bindsym XF86AudioLowerVolume exec --no-startup-id "pactl set-sink-volume 0 -5% && eww update volume=$(pactl get-sink-volume @DEFAULT_SINK@ | awk -F/ '{print $2}' | tr -dc 0-9)"

    # Screenshots (selection by default)
    bindsym Print exec --no-startup-id screen

    # Screen recording
    bindsym $mod+Print exec --no-startup-id record start
    bindsym $mod+Shift+Print exec --no-startup-id record stop

    # Music and sound
    bindsym $mod+m exec --no-startup-id "pactl set-sink-mute @DEFAULT_SINK@ toggle && sleep 0.05 && eww update volume-muted=$(pactl get-sink-mute @DEFAULT_SINK@ | sed 's/Mute: //')"
    bindsym $mod+space exec --no-startup-id playerctl play-pause
    bindsym $mod+n exec --no-startup-id playerctl next
    bindsym $mod+p exec --no-startup-id playerctl previous

    # Drag floating windows
    floating_modifier $mod

    # Reload the configuration file
    bindsym $mod+Shift+semicolon reload

    # Exit i3
    bindsym $mod+x exec 'i3-msg exit'

    # Launching the Windows VM
    bindsym $mod+v exec --no-startup-id toggleWin start
    bindsym $mod+Shift+v exec --no-startup-id toggleWin shutdown

    # Launching the file manager
    bindsym $mod+e exec --no-startup-id 'nemo'

# Moving around:
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

# Workspaces:
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10

    # External monitor workspaces (11-20 on F1-F10)
    bindsym $mod+F1 workspace number 11
    bindsym $mod+F2 workspace number 12
    bindsym $mod+F3 workspace number 13
    bindsym $mod+F4 workspace number 14
    bindsym $mod+F5 workspace number 15
    bindsym $mod+F6 workspace number 16
    bindsym $mod+F7 workspace number 17
    bindsym $mod+F8 workspace number 18
    bindsym $mod+F9 workspace number 19
    bindsym $mod+F10 workspace number 20
    bindsym $mod+Shift+F1 move container to workspace number 11
    bindsym $mod+Shift+F2 move container to workspace number 12
    bindsym $mod+Shift+F3 move container to workspace number 13
    bindsym $mod+Shift+F4 move container to workspace number 14
    bindsym $mod+Shift+F5 move container to workspace number 15
    bindsym $mod+Shift+F6 move container to workspace number 16
    bindsym $mod+Shift+F7 move container to workspace number 17
    bindsym $mod+Shift+F8 move container to workspace number 18
    bindsym $mod+Shift+F9 move container to workspace number 19
    bindsym $mod+Shift+F10 move container to workspace number 20

    # Pin 1-10 to the laptop panel, 11-20 to the external monitor
    # (11-20 fall back to the laptop panel when nothing is plugged in)
    set $ext nonprimary primary
    workspace 1 output primary
    workspace 2 output primary
    workspace 3 output primary
    workspace 4 output primary
    workspace 5 output primary
    workspace 6 output primary
    workspace 7 output primary
    workspace 8 output primary
    workspace 9 output primary
    workspace 10 output primary
    workspace 11 output $ext
    workspace 12 output $ext
    workspace 13 output $ext
    workspace 14 output $ext
    workspace 15 output $ext
    workspace 16 output $ext
    workspace 17 output $ext
    workspace 18 output $ext
    workspace 19 output $ext
    workspace 20 output $ext

    # Re-detect monitors (after plugging or unplugging one)
    bindsym $mod+o exec --no-startup-id "~/.config/i3/scripts/monitors.sh; ~/.config/eww/scripts/bars.sh"

    # Window resizing
    bindsym $mod+Left resize shrink width 20px
    bindsym $mod+Right resize grow width 20px
    bindsym $mod+Up resize grow height 20px
    bindsym $mod+Down resize shrink height 20px

# Layout:

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+t floating toggle
