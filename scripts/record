#!/bin/bash

# This script will use ffmpeg to record a video from the screen and audio from the microphone will be separated into a separate file.

# If the argument is "start" then the recording will start.
# If the argument is "stop" then the recording will stop.

FILENAME=$(date +%F_%T)
DIRECTORY="$HOME/media/screenrecords/"

# Make screenshot folder
mkdir -p $DIRECTORY

# "toggle" maps to stop if already recording, else start (passes through $2, e.g. "audio")
if [ "$1" = "toggle" ]; then
	if [ -e /tmp/recording ]; then set -- stop; else set -- start "$2"; fi
fi

if [ "$1" = "start" ]; then
	touch /tmp/recording
	dunstify "🔴 Recording Started"
	if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
		if [ "$2" = "audio" ]; then
			wf-recorder --audio --file="$DIRECTORY/$FILENAME.mp4"
		else
			wf-recorder --file="$DIRECTORY/$FILENAME.mp4"
		fi
	else
		if [ "$2" = "audio" ]; then
			ffmpeg -f x11grab -i "$DISPLAY" -f pulse -i default "$DIRECTORY/$FILENAME.mp4" &
		else
			ffmpeg -f x11grab -i "$DISPLAY" "$DIRECTORY/$FILENAME.mp4" &
		fi
	fi
fi

if [ "$1" = "stop" ]; then
	rm -f /tmp/recording
	dunstify "🔴 Recording Stopped"
	if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
		killall wf-recorder
	else
		killall ffmpeg
	fi
fi
