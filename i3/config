# i3 configuration

# Dark mode
set $gnome-schema org.gnome.desktop.interface
exec_always gsettings set $gnome-schema color-scheme 'prefer-dark'
exec_always gsettings set $gnome-schema gtk-theme 'Adwaita-dark'
exec_always --no-startup-id xdg-desktop-portal-gtk &

# Monitor
# HyperV + xrdp Enhanced Session: there is no physical eDP-1, and the resolution
# is negotiated dynamically over RDP, so the xrandr call is dropped here.
# exec xrandr --output eDP-1 --mode 1920x1080

# Spiral layout script (python-i3ipc package required)
set $spiralcmd python3 ~/.config/i3/scripts/spiral_layout.py

# Always run
exec_always --no-startup-id eww kill; eww daemon && eww open bar
exec_always --no-startup-id $spiralcmd
exec_always --no-startup-id dunst -conf ~/.config/dunst/dunstrc-x11

# HyperV + xrdp: load the PipeWire xrdp module so audio redirects to the Enhanced
# Session (Windows). i3 doesn't run XDG autostart, so trigger it here. The script
# self-guards (exits unless inside an xrdp session), and the sleep lets PipeWire come up.
exec --no-startup-id sh -c 'sleep 3; /usr/lib/pipewire-module-xrdp/load_pw_modules.sh'

# Compositor (glx backend, no effects — fixes input lag and pixel artifacts)
# HyperV + xrdp: glx is unavailable under xrdp's X server and xrdp manages the
# framebuffer itself, so picom is disabled here. Re-enable with `picom -b --backend xrender`
# only if a specific X11 redraw quirk appears in the Enhanced Session.
# exec --no-startup-id picom -b

# Pre-warm kitty server (launch on scratchpad so it's hidden)
exec --no-startup-id kitty --single-instance --class kitty-warmup
for_window [class="kitty-warmup"] move scratchpad

# Wallpaper
exec_always --no-startup-id feh --bg-scale ~/.config/wallpapers/img/pinkRose.jpg

# Disable startup notification cursor (loading spinner)
exec --no-startup-id xsetroot -cursor_name left_ptr

# Caps Lock to Escape
exec_always setxkbmap -option caps:escape

# Touchpad tap-to-click (auto-detects device name, works across laptops)
exec_always --no-startup-id ~/.config/i3/scripts/touchpad.sh

# Setting gaps
gaps inner 10

# Borders
default_border pixel 1

client.focused #FFFFFF99 #FFFFFF99 #FFFFFF99
client.unfocused #333333 #5F676A #FFFFFF #484E50 #5F676A

### Variables

# Mod1: Alt
# Mod4: Win
set $mod Mod4

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

set $term kitty --single-instance
set $menu rofi -show drun
set $browser env GDK_DPI_SCALE=1.25 zen-browser

### Key bindings

# Basics:
    # Start a terminal
    bindsym $mod+Return exec --no-startup-id $term
    bindsym Mod1+Return exec --no-startup-id $term

    # Open your browser
    bindsym $mod+b exec --no-startup-id $browser
    bindsym Mod1+b exec --no-startup-id $browser

    # Kill focused window
    bindsym $mod+w kill
    bindsym Mod1+w kill

    # Start your launcher
    bindsym $mod+r exec --no-startup-id $menu

    # Lock
    bindsym $mod+Mod1+l exec --no-startup-id "i3lock -i $HOME/.config/wallpapers/img/GtfoHD-1080.png"

    # Toggle bar
    bindsym $mod+semicolon exec --no-startup-id "eww close bar 2>/dev/null && exit 0; eww open bar"

    # Increase brightness
    bindsym XF86MonBrightnessUp exec --no-startup-id "brightnessctl s +1% && eww update backlight=$(brightnessctl -m | awk -F, '{print $4}' | tr -d '%')"
    bindsym XF86MonBrightnessDown exec --no-startup-id "brightnessctl s 1%- && eww update backlight=$(brightnessctl -m | awk -F, '{print $4}' | tr -d '%')"

    # Volume control
    bindsym XF86AudioRaiseVolume exec --no-startup-id "pactl set-sink-volume 0 +5% && eww update volume=$(pactl get-sink-volume @DEFAULT_SINK@ | awk -F/ '{print $2}' | tr -dc 0-9)"
    bindsym XF86AudioLowerVolume exec --no-startup-id "pactl set-sink-volume 0 -5% && eww update volume=$(pactl get-sink-volume @DEFAULT_SINK@ | awk -F/ '{print $2}' | tr -dc 0-9)"

    # Screenshots (selection by default)
    bindsym Print exec --no-startup-id screenshot
    # Print key isn't reliable over RDP, so bind screenshots to a $mod combo:
    bindsym $mod+s exec --no-startup-id screenshot

    # Screen recording (toggle: start, press again to stop)
    bindsym $mod+Shift+s exec --no-startup-id record toggle

    # Music and sound
    bindsym $mod+m exec --no-startup-id "pactl set-sink-mute @DEFAULT_SINK@ toggle && sleep 0.05 && eww update volume-muted=$(pactl get-sink-mute @DEFAULT_SINK@ | sed 's/Mute: //')"
    bindsym $mod+space exec --no-startup-id playerctl play-pause
    bindsym $mod+n exec --no-startup-id playerctl next
    bindsym $mod+p exec --no-startup-id playerctl previous

    # Drag floating windows
    floating_modifier $mod

    # Reload the configuration file
    bindsym $mod+Shift+semicolon reload

    # Exit i3
    bindsym $mod+x exec 'i3-msg exit'

    # Launching the Windows VM
    bindsym $mod+v exec --no-startup-id toggleWin start
    bindsym $mod+Shift+v exec --no-startup-id toggleWin shutdown

    # Launching the file manager
    bindsym $mod+e exec --no-startup-id 'nemo'

# Moving around:
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

    # Alt Keys: left & right navigation with Alt keys
    bindsym Mod1+$right focus right
    bindsym Mod1+$left focus left
    bindsym Mod1+Shift+$left move left
    bindsym Mod1+Shift+$right move right

# Workspaces:
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10

    # Window resizing
    bindsym $mod+Left resize shrink width 20px
    bindsym $mod+Right resize grow width 20px
    bindsym $mod+Up resize grow height 20px
    bindsym $mod+Down resize shrink height 20px

# Layout:

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+t floating toggle
